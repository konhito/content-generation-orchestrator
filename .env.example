# Copy to `.env` in the repo root and fill in what you use.

OPENAI_API_KEY=

# Free meme provider used by Shorts meme-plan/components.
# MCP_MEME_TEMPLATE_ID can pin one preferred Imgflip template id.
MCP_MEME_TEMPLATE_ID=
IMGFLIP_USERNAME=
IMGFLIP_PASSWORD=

# Optional paid TTS provider. Edge TTS is default and needs no key.
ELEVENLABS_API_KEY=
